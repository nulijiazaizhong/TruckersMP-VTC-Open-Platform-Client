# ============================================================================
# VTC 客户端 .env（多车队定制的关键，规划 §2.4）
# 所有车队共享同一份客户端代码，仅 .env 不同。
# 安全：只放"连接与展示"类配置，严禁任何后端 secret
#       （DB 密码 / S3 secret / JWT secret / GitHub token 等都在服务端 .env）。
# 查找顺序：VTC_HOME 环境变量 → 可执行文件目录/.env → .config/.env
# 品牌字段（TEAM_*/LOGIN_*/ACCENT_COLOR）可被 /api/v1/config/public 覆盖。
# ============================================================================

# ==== 开发模式（可选）====
# true = 开发模式：VTC_API_BASE 默认指向本地 docker 服务端（127.0.0.1:8731），
#        并在窗口标题显示 [DEV · 地址] 标识，避免开发/生产混淆。
#        命令行 --dev 优先级更高（F5 调试可直接带参，见 launch.json）。
#        也可 --api-base=http://127.0.0.1:9999 指定 docker 映射到其它端口。
VTC_DEV_MODE=

# ==== 指向本队后端 ====
VTC_API_BASE=http://127.0.0.1:8731
VTC_WS_BASE=                      # 推送地址（可缺省，由 API 推导 ws/wss）

# ==== 品牌（可被后端 /config/public 覆盖，此处为兜底/离线占位）====
TEAM_NAME=中国夜安物流
TEAM_SLOGAN=松散，自由的行驶、玩耍
# 支持三种源：
#   1) pack://app-assets/brand/logo.png   Avalonia 资源（打包进 exe）
#   2) 本地文件路径（如 D:\brand\logo.png）
#   3) http(s) 远程链接（如 https://api.goodnightan.com/api/random?type=pc）
#      —— 远程源需其 host 命中下方 VTC_CDN_DOMAINS 白名单（或 VTC_API_BASE 同源），
#         否则回退 pack:// 兜底。远程图缓存 24h（.brand-cache），仅 jpg/png/webp、≤10MB、≤4096px。
TEAM_LOGO=pack://app-assets/brand/logo.png
LOGIN_BG=pack://app-assets/brand/login_bg.jpg
# 登录版式：left(表单居左) | right(表单居右) | center(居中叠加)   见 §2.3
LOGIN_LAYOUT=left
# 强调色 #RRGGBB（注入 Themes 颜色令牌，§4.3）
ACCENT_COLOR=#1E88E5
# 应用图标（运行时窗口/任务栏图标，覆盖编译期 .ico）。
# 支持本地文件（.ico/.png）/ pack:// / http(s)（远程需 VTC_CDN_DOMAINS 白名单）。
# 留空 = 用 csproj 的 ApplicationIcon（app-assets\app.ico，exe 文件图标）。
# 例：VTC_APP_ICON=D:\brand\vtc.ico   或   VTC_APP_ICON=https://cdn.team.com/icon.png
VTC_APP_ICON=

# ==== 认证 ====
AUTH_MODE=hybrid                  # password | steam | hybrid
STEAM_API_KEY=                    # 留空则不启用 Steam 绑定（勿填真实 key 到客户端 .env）
TMP_SERVER_ID=                    # 本队 TM:MP 服务器 id（身份绑定，P1 启用）

# ==== 存档 / 资源 ====
# SaveData 文件夹（profile 存档）。也可在设置页"存档目录"选择（优先）。
SAVE_DIR=%USERPROFILE%\Documents\Euro Truck Simulator 2\mods\SaveData
# 游戏安装目录（DLC 扫描 dlc_*.scs）。也可在设置页"游戏目录"选择（优先）。
GAME_DIR=
ALLOW_UPLOAD=true

# ==== 远程品牌图/图标 CDN 白名单（§2.3 安全规则，逗号分隔域名）====
# TEAM_LOGO / LOGIN_BG / VTC_APP_ICON 用 http(s) 时，其 host 必须命中：
#   ① VTC_API_BASE 同主机（含端口），或
#   ② 本白名单列出的域名（支持子域：填 cdn.example.com 则 a.b.cdn.example.com 也允许）。
# 其它 https 源一律回退本地 pack:// 兜底（防任意外部图注入）。
# 例（允许 goodnightan 随机图 API + 自有 CDN）：
# VTC_CDN_DOMAINS=api.goodnightan.com,cdn.yourteam.com
VTC_CDN_DOMAINS=

# ==== 其它 ====
UPDATE_CHANNEL=stable             # stable | beta
LOG_LEVEL=info                    # debug | info | warning | error
