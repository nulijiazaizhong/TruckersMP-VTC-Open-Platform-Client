<UserControl xmlns="https://github.com/avaloniaui"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              x:Class="VTC.Client.Views.NewsView"
              x:Name="root">
  <DockPanel Margin="20,16,20,0">
    <!-- 顶部标签：欧卡(ETS2) / 美卡(ATS) + 刷新 -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,14">
      <Button x:Name="tabEts2" Content="欧卡（ETS2）" Width="140" Height="36"
              Background="{DynamicResource vtc_accent}" Foreground="White"
              CornerRadius="6" Click="OnTabClick" Tag="ets2"/>
      <Button x:Name="tabAts" Content="美卡（ATS）" Width="140" Height="36"
              Background="Transparent" Foreground="#BBB" BorderBrush="#444"
              CornerRadius="6" Click="OnTabClick" Tag="ats"/>
      <Button x:Name="btnRefresh" Content="刷新" Margin="12,0,0,0" Width="70" Height="36"
              CornerRadius="6" Click="OnRefreshClick"/>
      <TextBlock x:Name="sourceHint" VerticalAlignment="Center" Margin="12,0,0,0"
                 FontSize="12" Foreground="#888"/>
    </StackPanel>

    <!-- 加载状态 -->
    <TextBlock x:Name="loadingHint" DockPanel.Dock="Top"
               Text="正在加载资讯…" Foreground="#888" Margin="0,20,0,0"
               IsVisible="False"/>

    <!-- 空状态 -->
    <TextBlock x:Name="emptyHint" DockPanel.Dock="Top"
               Text="暂无资讯（RSS 源可能不可达或无新内容）"
               Foreground="#999" HorizontalAlignment="Center" Margin="0,40"
               IsVisible="False"/>

    <!-- ===== 文章详情面板（点击条目后显示，列表隐藏）===== -->
    <ScrollViewer x:Name="detailPanel" IsVisible="False">
      <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <Button x:Name="btnBack" Content="← 返回列表" HorizontalAlignment="Left"
                Width="120" Height="32" Margin="0,0,0,14"
                Click="OnBackClick" Foreground="#888"/>
        <TextBlock x:Name="detailTitle" FontSize="19" FontWeight="Bold"
                   Foreground="#F0F0F0" TextWrapping="Wrap" Margin="0,0,0,8"/>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
          <TextBlock x:Name="detailDate" FontSize="12" Foreground="#888"/>
          <TextBlock x:Name="detailVersion" FontSize="12" Foreground="#666"
                     Margin="10,0,0,0"/>
        </StackPanel>
        <Button x:Name="btnBrowser" Content="在浏览器打开原文 ↗" HorizontalAlignment="Left"
                Width="160" Height="32" Margin="0,0,0,16"
                Click="OnBrowserClick"/>
        <!-- 正文（HTML → 富文本） -->
        <Border Background="#1E1E22" CornerRadius="8" Padding="16,14">
          <TextBlock x:Name="detailBody" FontSize="13" Foreground="#CCC"
                     TextWrapping="Wrap" LineHeight="22"/>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- ===== 资讯列表（当前 tab 的游戏）===== -->
    <ItemsControl x:Name="list">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Padding="14,12" BorderBrush="#333" BorderThickness="0,0,0,1"
                  Background="Transparent" Cursor="Hand"
                  PointerPressed="OnItemPressed" Tag="{Binding}">
            <DockPanel>
              <StackPanel DockPanel.Dock="Right" MinWidth="90" Margin="12,0,0,0"
                          VerticalAlignment="Top" HorizontalAlignment="Right">
                <TextBlock Text="{Binding DateText}" FontSize="12" Foreground="#888"/>
                <TextBlock Text="{Binding GameVersionTag}" FontSize="11" Foreground="#666"
                           Margin="0,2,0,0"/>
              </StackPanel>
              <StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Medium"
                           Foreground="#E0E0E0" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#999"
                           TextWrapping="Wrap" Margin="0,4,0,0"
                           IsVisible="{Binding HasSummary}"/>
                <TextBlock x:Name="detailHint" Text="点击阅读全文 →" FontSize="11"
                           Foreground="#5a8fc7" Margin="0,4,0,0"/>
              </StackPanel>
            </DockPanel>
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </DockPanel>
</UserControl>
