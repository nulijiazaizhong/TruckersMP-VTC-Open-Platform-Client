<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="VTC.Client.Views.AdminView"
             x:Name="root">

  <UserControl.Styles>
    <Style Selector="TextBlock.h"><Setter Property="FontSize" Value="16"/><Setter Property="FontWeight" Value="Bold"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
    <Style Selector="TextBlock.lbl"><Setter Property="FontSize" Value="13"/><Setter Property="Margin" Value="0,0,0,4"/></Style>
    <Style Selector="TextBox.f"><Setter Property="Height" Value="34"/><Setter Property="CornerRadius" Value="6"/><Setter Property="Padding" Value="8,0"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <!-- ComboBox 文字也垂直居中（避免下拉框文字贴顶） -->
    <Style Selector="ComboBox.f"><Setter Property="Height" Value="34"/><Setter Property="MinWidth" Value="140"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  </UserControl.Styles>

  <!-- HorizontalScrollBarVisibility=Disabled：把视口宽度作为约束传给内层 Grid，
       否则 ScrollViewer 给子元素 infinite 宽度，两列 * 会塌缩到内容宽 → 输入框不铺满/偏移。 -->
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24,16,24,0">

      <!-- ① 活动设置 -->
      <StackPanel>
        <TextBlock Classes="h" Text="活动设置"/>
        <TextBlock Classes="lbl" Text="活动标题"/>
        <TextBox x:Name="evtName" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="活动图片"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="上传" Width="80" Height="34" CornerRadius="6"
                  Background="{DynamicResource vtc_accent}" Foreground="White" Click="OnUploadImageClick"/>
          <TextBlock x:Name="imgHint" VerticalAlignment="Center" FontSize="12" Foreground="#888"
                     Text="P1：活动图上传（直传对象存储）"/>
        </StackPanel>
        <TextBlock Classes="lbl" Text="活动时间"/>
        <TextBox x:Name="evtActivityAt" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="发车时间"/>
        <TextBox x:Name="evtDepartAt" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="活动服务器"/>
        <TextBox x:Name="evtServer" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="导航方式"/>
        <TextBox x:Name="evtNav" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="活动存档"/>
        <StackPanel Orientation="Horizontal">
          <Button Content="上传存档" Width="90" Height="34" CornerRadius="6"
                  Background="{DynamicResource vtc_accent}" Foreground="White" Click="OnUploadSaveClick"/>
          <TextBlock x:Name="saveHint" VerticalAlignment="Center" FontSize="12" Foreground="#888"
                     Text="P1：直传 + 发布（publish）"/>
        </StackPanel>
        <TextBlock Classes="lbl" Text="requires_map_dlc（豁免不禁的地图包，逗号分隔）"/>
        <TextBox x:Name="evtRequiresMapDlc" Classes="f" Tag=""/>
        <Button Content="保存活动" Width="140" Height="38" Margin="0,6,0,0"
                Background="{DynamicResource vtc_accent}" Foreground="White" CornerRadius="6"
                Click="OnSaveEventClick"/>
        <TextBlock x:Name="evtStatus" FontSize="12" Foreground="#1B7A43" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- ② 服务端设置 -->
      <TextBlock Classes="h" Text="服务端设置" Margin="0,28,0,10"/>
      <StackPanel>
        <TextBlock Classes="lbl" Text="存储类型"/>
        <ComboBox x:Name="storageType" Classes="f" SelectedIndex="0">
          <ComboBoxItem Content="对象存储（S3 兼容：R2/MinIO/OSS…）"/>
          <ComboBoxItem Content="仓库（GitHub）"/>
        </ComboBox>
        <TextBlock Classes="lbl" Text="存储端点 / 仓库"/>
        <TextBox x:Name="storageEndpoint" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="桶 / 分支"/>
        <TextBox x:Name="storageBucket" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="应用密钥 ID / token"/>
        <TextBox x:Name="storageKeyId" Classes="f" Tag=""/>
        <TextBlock Classes="lbl" Text="应用密钥 / 路径"/>
        <TextBox x:Name="storageSecret" Classes="f" Tag="" PasswordChar="•"/>
        <TextBlock Classes="lbl" Text="文件路径前缀 / 权限"/>
        <TextBox x:Name="storagePrefix" Classes="f" Tag=""/>
        <Button Content="保存服务端设置" Width="160" Height="38" Margin="0,6,0,0"
                Background="{DynamicResource vtc_accent}" Foreground="White" CornerRadius="6"
                Click="OnSaveServerClick"/>
        <TextBlock Text="注：服务端凭据（S3 secret / GitHub token / DB 密码）保存在后端 .env，不在客户端 .env（§2.4 安全规则）。此表单为 P1 可视化配置入口。"
                   FontSize="12" Foreground="#888" TextWrapping="Wrap" Margin="0,8,0,0"/>
        <TextBlock x:Name="serverStatus" FontSize="12" Foreground="#1B7A43" Margin="0,4,0,0"/>
      </StackPanel>

      <!-- ③ 用户管理 -->
      <TextBlock Classes="h" Text="用户管理" Margin="0,28,0,10"/>
      <StackPanel>
        <TextBlock Text="添加 / 删除平台账号。密码默认随机生成（创建时显示一次，之后请用户自行修改）；权限组：Admin / Manager / Driver / Member。"
                    FontSize="12" Foreground="#888" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,0,0,8">
          <TextBlock Text="用户名" VerticalAlignment="Center" FontSize="13"/>
          <TextBox x:Name="usrUsername" Classes="f" Width="160"/>
          <TextBlock Text="权限组" VerticalAlignment="Center" FontSize="13"/>
          <ComboBox x:Name="usrRole" Classes="f" Width="150">
            <ComboBoxItem Content="Admin（管理员）"/>
            <ComboBoxItem Content="Manager（管理）"/>
            <ComboBoxItem Content="Driver（司机）"/>
            <ComboBoxItem Content="Member（成员）"/>
          </ComboBox>
          <TextBlock Text="密码" VerticalAlignment="Center" FontSize="13"/>
          <TextBox x:Name="usrPassword" Classes="f" Width="200" PasswordChar="•"
                   ToolTip.Tip="留空 = 自动生成随机密码（推荐）"/>
          <Button x:Name="btnAddUser" Content="添加用户" Width="96" Height="34" CornerRadius="6"
                  Background="{DynamicResource vtc_accent}" Foreground="White" Click="OnAddUserClick"/>
        </StackPanel>
        <TextBlock x:Name="usrStatus" FontSize="12" Margin="0,4,0,0"/>

        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,14,0,6">
          <Button Content="刷新列表" Width="92" Height="30" CornerRadius="6"
                  Background="{DynamicResource vtc_accent}" Foreground="White" Click="OnRefreshUsersClick"/>
          <TextBlock x:Name="usrCount" VerticalAlignment="Center" FontSize="12" Foreground="#888"/>
        </StackPanel>
        <ScrollViewer MaxHeight="280" HorizontalScrollBarVisibility="Disabled" Margin="0,6,0,0">
          <StackPanel x:Name="membersList"/>
        </ScrollViewer>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
