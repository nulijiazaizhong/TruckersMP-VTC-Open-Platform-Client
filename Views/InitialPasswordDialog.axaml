<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="VTC.Client.Views.InitialPasswordDialog"
        Title="用户已添加" Width="460" SizeToContent="Height"
        CanResize="False" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="#141821" FontSize="14">

  <!-- 配色与管理页一致（#141821 卡片 / #2A303B 边 / #E8EAED 主文字）；按钮 hover 覆盖
       Fluent 模板默认背景，写法同 HomeView.deploy-btn。 -->
  <Window.Styles>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource vtc_accent_hover}"/>
    </Style>
    <Style Selector="Button.plain:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#343B49"/>
    </Style>
  </Window.Styles>

  <StackPanel Margin="24,22,24,20" Spacing="14">
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Text="✅" FontSize="24" VerticalAlignment="Center"/>
      <StackPanel Spacing="4">
        <TextBlock x:Name="titleText" FontSize="17" FontWeight="SemiBold" Foreground="#E8EAED"/>
        <TextBlock x:Name="subText" Text="初始密码仅此一次展示，请复制后告知用户，其登录后应立即修改。"
                   FontSize="12" Foreground="#8A93A0" TextWrapping="Wrap"/>
      </StackPanel>
    </StackPanel>

    <Border x:Name="pwdPanel" Background="#0D0F14" BorderBrush="#2A303B" BorderThickness="1"
            CornerRadius="8" Padding="14,10">
      <StackPanel Spacing="6">
        <TextBlock Text="初始密码" FontSize="12" Foreground="#8A93A0"/>
        <!-- 只读文本框：等宽字体便于核对，且可手动拖选 -->
        <TextBox x:Name="pwdBox" IsReadOnly="True" TextWrapping="Wrap"
                 Background="Transparent" Foreground="#E8EAED" BorderThickness="0"
                 FontSize="16" Padding="0" FontFamily="Consolas"/>
      </StackPanel>
    </Border>

    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10">
      <Button x:Name="btnCopy" Classes="primary" Content="复制初始密码" Height="36" MinWidth="120"
              CornerRadius="6" Background="{DynamicResource vtc_accent}" Foreground="White"
              FontWeight="SemiBold" Cursor="Hand" Click="OnCopyClick"/>
      <Button x:Name="btnClose" Classes="plain" Content="关闭" Height="36" MinWidth="90"
              CornerRadius="6" Background="#2A303B" Foreground="#E8EAED"
              Cursor="Hand" Click="OnCloseClick"/>
    </StackPanel>
  </StackPanel>
</Window>
